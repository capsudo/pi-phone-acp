{
  "name": "pi-phone-acp",
  "version": "3.0.0",
  "description": "ACP adapter for a phone-owned pi-phone agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.7.0",
    "marked": "18.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "pi-phone-acp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capsudo/pi-phone-acp.git"
  },
  "homepage": "https://github.com/capsudo/pi-phone-acp#readme",
  "bugs": {
    "url": "https://github.com/capsudo/pi-phone-acp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
